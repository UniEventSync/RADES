NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Fixed OSSIE bootstrap identity. Create/update with npm run seed:ossie.
OSSIE_EMAIL=
OSSIE_PASSWORD=
