# Copy to .env.local. Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Fixed OSSIE bootstrap identity. Create/update with `npm run seed:ossie`.
OSSIE_EMAIL=ossie@iba.edu.pk
OSSIE_PASSWORD=
OSSIE_FIRST_NAME=RADES
OSSIE_LAST_NAME=OSSIE

# Development only: shared password for the five seeded super-admin accounts.
DEVELOPER_PASSWORD=

# Resend test sender. SMTP_PASSWORD must be the same value as RESEND_API_KEY.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=RADES <onboarding@resend.dev>
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=

# Sprint 2 placeholders (not used in Sprint 1)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
