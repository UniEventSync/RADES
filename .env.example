OSSIE_LAST_NAME=

# Resend test sender. SMTP_PASSWORD must be the same value as RESEND_API_KEY.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Sprint 2 placeholders (not used in Sprint 1)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
DEVELOPER_PASSWORD=
