# Copy to .env.local. Supabase Dashboard > Project Settings > API.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Fixed OSSIE bootstrap identity. Create/update with npm run seed:ossie.
OSSIE_EMAIL=
OSSIE_PASSWORD=
OSSIE_FIRST_NAME=
OSSIE_LAST_NAME=

# Resend test sender. SMTP_PASSWORD must be the same value as RESEND_API_KEY.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Stripe-hosted event Checkout. Use test-mode values only: sk_test_ and pk_test_.
# STRIPE_WEBHOOK_SECRET is provided by Stripe CLI or the test webhook endpoint.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Google Cloud OAuth 2.0 Web client ID; enable Google Calendar API for the project.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
DEVELOPER_PASSWORD=
